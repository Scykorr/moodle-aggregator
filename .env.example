# Скопируйте в .env и при необходимости отредактируйте.
# Конфигуратор Moodle тоже обновляет этот файл.

MOODLE_BRANCH=MOODLE_502_STABLE
MOODLE_HTTP_PORT=80
MOODLE_WWWROOT=http://localhost

MOODLE_SITE_FULLNAME=Moodle LMS
MOODLE_SITE_SHORTNAME=Moodle
MOODLE_ADMIN_USER=admin
MOODLE_ADMIN_PASSWORD=Admin123!
MOODLE_ADMIN_EMAIL=admin@example.com
MOODLE_LANG=ru

MOODLE_DATABASE_NAME=moodle
MOODLE_DATABASE_USER=moodle
MOODLE_DATABASE_PASSWORD=moodlepass
MOODLE_DATABASE_PREFIX=mdl_
MYSQL_ROOT_PASSWORD=rootpass
